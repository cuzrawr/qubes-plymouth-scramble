# qubes-plymouth-scramble: new scrambled digit layout for the disk password prompt, every boot.
# Initramfs only. Must finish before plymouthd reads vconsole.conf and the theme.
[Unit]
Description=Scrambled digit keys for the disk password prompt
DefaultDependencies=no
Before=plymouth-start.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/qubes-plymouth-scramble/qubes-scramble.sh
StandardOutput=journal+console
StandardError=journal+console
