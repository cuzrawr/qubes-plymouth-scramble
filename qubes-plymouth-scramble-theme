def load_base():
    """Load the shared validation code alongside the builder once per interpreter."""
    name = "qubes_plymouth_scramble_base"
    if name not in sys.modules:
        loader = importlib.machinery.SourceFileLoader(name, os.path.join(SOURCE_DIR, "qubes-plymouth-scramble"))
        spec = importlib.util.spec_from_loader(name, loader)
        module = importlib.util.module_from_spec(spec)
        sys.modules[name] = module
        loader.exec_module(module)
    return sys.modules[name]


